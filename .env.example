# ============================================================
# NutriScan — Environment Variables
# ============================================================
# Salin file ini menjadi .env lalu isi dengan nilai asli:
#   cp .env.example .env
#
# JANGAN commit file .env ke Git! (sudah ada di .gitignore)
# ============================================================

# --- Supabase (wajib) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Backend ---
NODE_ENV=production
PORT=3000

# --- Frontend (URL backend yang diakses oleh Expo web) ---
# Saat development lokal: http://localhost:3000
# Saat production: https://api.domain-kamu.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- API Keys tambahan (uncomment jika digunakan) ---
# GEMINI_API_KEY=AIza...
# JWT_SECRET=rahasia-panjang-acak
