SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Saran Nutrisi (Google Gemini - GRATIS). Ambil key di https://aistudio.google.com/apikey
# Tanpa kartu kredit. Model gratis & cepat: gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: use absolute path if model is moved
MODEL_PATH=./model/best.pt

# Optional: set python executable, e.g. py, python3, or full path
PYTHON_EXECUTABLE=python

# Optional: comma separated labels by class index
# Example: Nasi Goreng,Ayam Goreng,Mie Goreng,Sate Ayam,Gado-gado
FOOD_LABELS=Nasi Goreng,Ayam Goreng,Mie Goreng,Sate Ayam,Gado-gado
